{
  "version": 2,
  "builds": [
    {
      "src": "team_todo/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "installCommand": "apt-get update -y && apt-get install -y libpq-dev gcc && pip install -r requirements.txt"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "team_todo/wsgi.py"
    }
  ]
}
