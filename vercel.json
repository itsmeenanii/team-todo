{
  "version": 2,
  "builds": [
    {
      "src": "collaborative_todo/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.10"
      }
    },
    {
      "src": "manage.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/vercel-health",
      "dest": "collaborative_todo/urls.py"
    },
    {
      "src": "/health",
      "dest": "collaborative_todo/urls.py"
    },
    {
      "src": "/admin/(.*)",
      "dest": "collaborative_todo/wsgi.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "collaborative_todo/wsgi.py"
    },
    {
      "src": "/(.*)",
      "dest": "collaborative_todo/wsgi.py"
    }
  ],
  "env": {
    "PYTHONPATH": ".",
    "DJANGO_SETTINGS_MODULE": "collaborative_todo.settings"
  },
  "functions": {
    "collaborative_todo/wsgi.py": {
      "memory": 1024,
      "maxDuration": 10
    }
  }
}
