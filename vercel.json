{
  "version": 2,
  "builds": [
    {
      "src": "team_todo/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/health",
      "dest": "team_todo/wsgi.py"
    },
    {
      "src": "/admin/(.*)",
      "dest": "team_todo/wsgi.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "team_todo/wsgi.py"
    },
    {
      "src": "/(.*)",
      "dest": "team_todo/wsgi.py"
    }
  ]
}
