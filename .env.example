# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=False

# Database (Required for Vercel)
DATABASE_URL=postgresql://user:password@host:port/database_name

# Alternative: Individual DB settings (for local development)
DB_NAME=collaborative_todo
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis (for Celery - optional on Vercel)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@collaborativetodo.com

# Firebase Cloud Messaging
FIREBASE_CREDENTIALS=/path/to/firebase-credentials.json
FIREBASE_PROJECT_ID=your-project-id

# Twilio (SMS)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://your-app.vercel.app

# AWS S3 (for media files)
USE_S3=False
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name

# App settings
GROUP_TASK_AUTO_GENERATE_TIME=09:00
OTP_EXPIRY_MINUTES=10

# Security (production)
SECURE_SSL_REDIRECT=True
